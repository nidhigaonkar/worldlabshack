# Copy this file to .env and fill in your API keys

# World Labs API - for 3D world generation
VITE_WORLDLABS_API_KEY=your_worldlabs_api_key_here

# OpenAI API - for generating world descriptions
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API - for ambient sound generation
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Gemini API - for transition image generation
VITE_GEMINI_API_KEY=your_gemini_api_key_here
